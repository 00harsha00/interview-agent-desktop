{
  "name": "iai-desktop",
  "version": "1.0.1",
  "description": "IAI — Real-time AI interview assistant desktop overlay",
  "author": "IAI",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "clean": "rimraf dist out",
    "icons": "node scripts/make-icons.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "rimraf dist out && electron-vite build && electron-builder --mac",
    "dist:win": "rimraf dist out && electron-vite build && electron-builder --win",
    "dist:all": "rimraf dist out && electron-vite build && electron-builder --mac --win",
    "release:mac": "rimraf dist out && electron-vite build && electron-builder --mac --publish always",
    "release:win": "rimraf dist out && electron-vite build && electron-builder --win --publish always",
    "release:all": "rimraf dist out && electron-vite build && electron-builder --mac --win --publish always",
    "install:mac": "npm run dist:mac && pkill -x IAI; rm -rf /Applications/IAI.app && ditto dist/mac-arm64/IAI.app /Applications/IAI.app && rm -rf dist/mac-arm64 && open /Applications/IAI.app"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.iai.desktop",
    "productName": "IAI",
    "icon": "resources/icon",
    "publish": {
      "provider": "github",
      "owner": "00harsha00",
      "repo": "interview-agent-desktop",
      "private": true,
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "protocols": [
      {
        "name": "IAI",
        "schemes": [
          "iai-desktop",
          "iai-desktop-dev"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/icon.*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/**/{test,tests,__tests__,docs,doc,example,examples}/**",
      "!**/node_modules/**/*.{md,markdown,ts,map}",
      "!**/node_modules/**/{.github,coverage}/**"
    ]
  }
}
